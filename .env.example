# Copy to .env. Every value here is a local development default.
# Nothing in this file is a secret and nothing in it reaches a real service.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Four URLs, and the differences between them are load bearing.
#
#   APP       -> through pgbouncer in TRANSACTION mode. This is what makes
#                SET LOCAL app.user_id safe. Connects as ledger_app, which does
#                NOT own the tables, so row level security actually applies.
#   MIGRATOR  -> direct to Postgres as the owning role. Alembic only.
#   WORKER    -> direct to Postgres. procrastinate uses LISTEN/NOTIFY, which
#                does not survive a transaction-mode pooler.
#   SESSION   -> through pgbouncer in SESSION mode. Used by exactly one test,
#                which must FAIL. See TC-SEC-005.
DATABASE_URL=postgresql+asyncpg://ledger_app:ledger_app_pw@localhost:6432/ledger
DATABASE_MIGRATOR_URL=postgresql+psycopg://ledger_migrator:ledger_migrator_pw@localhost:5432/ledger
DATABASE_WORKER_URL=postgresql+asyncpg://ledger_app:ledger_app_pw@localhost:5432/ledger
DATABASE_SESSION_MODE_URL=postgresql+asyncpg://ledger_app:ledger_app_pw@localhost:6433/ledger

TEST_DATABASE_URL=postgresql+asyncpg://ledger_app:ledger_app_pw@localhost:6432/ledger_test
TEST_DATABASE_MIGRATOR_URL=postgresql+psycopg://ledger_migrator:ledger_migrator_pw@localhost:5432/ledger_test
TEST_DATABASE_SESSION_MODE_URL=postgresql+asyncpg://ledger_app:ledger_app_pw@localhost:6433/ledger_test

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Two endpoints on purpose. A presigned URL's signature covers the host, so a
# URL signed for an address the browser cannot resolve is unusable and cannot
# be rewritten afterwards. S3_ENDPOINT is where this process talks to storage.
# S3_PUBLIC_ENDPOINT is the address the browser will use, and is the one used
# for signing. Running the API on the host these are equal. Running it inside
# compose, S3_ENDPOINT becomes http://minio:9000 and the public one stays
# localhost. In AWS both are empty and boto3 derives them from the region.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=ledger-statements
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO requires path-style addressing. AWS accepts it too, so this stays true
# in both environments rather than becoming a branch.
S3_FORCE_PATH_STYLE=true
# Sent locally as well as in production so TC-SEC-008 means something before
# the first deploy.
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_PRESIGN_EXPIRY_SECONDS=900

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Local only. Generate a real one for any deployed environment.
SESSION_SECRET=dev-only-not-a-secret-change-me
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=ledger_session
SESSION_COOKIE_SECURE=false

# OIDC (Auth0, ADR-008). Leave blank for local dev and the test suite -- the
# password path and the whole suite run with no external identity provider
# configured. Fill these in from an Auth0 Regular Web Application to exercise
# the /auth/oidc/* routes: AUTH0_DOMAIN is the tenant domain with no scheme
# (e.g. your-tenant.us.auth0.com), and AUTH0_REDIRECT_URI must be registered
# in that application's Allowed Callback URLs exactly as written here.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# "fake" is deterministic and offline. It is the default everywhere except
# production, so no API key is needed to run or test anything.
LLM_ADAPTER=fake
# Most capable by default. A wrong alias is cached and then reused for every
# tenant, so accuracy here compounds while cost does not: the bill tracks
# distinct new merchants, not transactions. claude-sonnet-5 and
# claude-haiku-4-5 are cheaper if you decide the trade is worth it.
LLM_MODEL=claude-opus-5
LLM_BATCH_SIZE=50
LLM_PROMPT_VERSION=v1
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRGM_SIMILARITY_THRESHOLD=0.6
# Salt for descriptor_key_hash in logs. Rotating it breaks correlation between
# old and new log lines, which is the intended trade-off.
LOG_HASH_SALT=dev-only-log-salt
